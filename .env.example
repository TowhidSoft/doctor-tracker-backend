# MongoDB connection (Prisma needs a replica set; MongoDB Atlas has one by default)
DATABASE_URL="mongodb://127.0.0.1:27017/doctor_tracker?replicaSet=rs0"

# Server
PORT=8080

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET_KEY="YOUR_ACCESS_SECRET_KEY"
JWT_REFRESH_SECRET_KEY="YOUR_REFRESH_SECRET_KEY"

# Browser origin of the Next.js client (CORS)
FRONTEND_URL="http://localhost:3000"

# Timezone used to bucket dashboard charts and date filters by day (IANA name)
APP_TIMEZONE="Asia/Dhaka"

# Admin created on first boot. Change these before deploying!
Admin_Email="admin@gmail.com"
Admin_Password="123456"
